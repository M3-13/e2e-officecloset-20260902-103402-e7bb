# Vorlage für lokale Umgebungsvariablen.
#
# Diese Datei benennt jede Variable, die das Backend beim Start braucht.
# Die App liest die Werte aus der Prozessumgebung (RUN.json erzeugt sie beim
# CI-/Tester-Start automatisch). Für den lokalen Start kopieren Sie die
# Werte entweder in die Umgebung oder exportieren Sie sie direkt vor dem
# Start (siehe README, Abschnitt "Start").

# Signaturgeheimnis für JWT — zufälligen Wert erzeugen und exportieren:
#   Windows (PowerShell):
#     $env:JWT_SECRET_KEY = python -c "import secrets; print(secrets.token_hex(32))"
#   macOS/Linux:
#     export JWT_SECRET_KEY=$(python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=

DATABASE_URL=sqlite:///./dev.db
ACCESS_TOKEN_EXPIRE_MINUTES=15
FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
